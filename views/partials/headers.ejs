<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= typeof title !== 'undefined' ? title : 'Blog Platform' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href="/blogs">DevBlog</a>
    <div class="navbar-nav ms-auto align-items-center">
      <% if (currentUser) { %>
        <a class="nav-link" href="/blogs/create">Write Blog</a>
        <a class="nav-link" href="/dashboard">Dashboard</a>
        <% if (currentUser.role === 'Admin') { %>
          <a class="nav-link text-warning" href="/users">Manage Users</a>
        <% } %>
        <span class="navbar-text ms-3 me-2 text-white">Hi, <%= currentUser.name %></span>
        <form action="/api/auth/logout" method="POST" class="d-inline">
          <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
        </form>
      <% } else { %>
        <a class="nav-link" href="/login">Login</a>
        <a class="btn btn-primary btn-sm ms-2" href="/register">Register</a>
      <% } %>
    </div>
  </div>
</nav>
<div class="container">
  <%- include('./alerts') %>