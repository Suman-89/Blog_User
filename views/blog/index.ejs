<%- include('../partials/headers') %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>All Blog Articles</h2>
  <% if (currentUser) { %>
    <a href="/blogs/create" class="btn btn-primary">+ New Blog</a>
  <% } %>
</div>

<div class="row">
  <% if (blogs.length === 0) { %>
    <p class="text-muted">No blogs found.</p>
  <% } %>
  <% blogs.forEach(blog => { %>
    <div class="col-md-4 mb-4">
      <div class="card h-100 shadow-sm">
        <% if (blog.blogImage) { %>
          <img src="/<%= blog.blogImage %>" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Blog thumbnail" />
        <% } %>
        <div class="card-body">
          <h5 class="card-title"><%= blog.title %></h5>
          <p class="card-text text-truncate"><%= blog.content %></p>
          <p class="card-text"><small class="text-muted">By <%= blog.author ? blog.author.name : 'Unknown' %></small></p>
          <% if (blog.isDeleted) { %>
            <span class="badge bg-danger mb-2">Trash (Admin View)</span>
          <% } %>
          <div>
            <a href="/blogs/<%= blog._id %>" class="btn btn-sm btn-outline-primary">Read More</a>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include('../partials/footer') %>